# Dependencies
# NOTE: package-lock.json is intentionally TRACKED. Without it `npm ci` cannot
# run, dev/CI installs are not reproducible, and transitive dependency updates
# land silently.
node_modules/
yarn.lock

# Build outputs
dist/
build/
.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
playwright-report/
test-results/
e2e-out.txt
full-run.txt

# Environment variables
.env
.env.local
.env.*.local

# Certificates / private keys (NEVER commit these)
*.pem
*.key
*.crt
*.p12
*.pfx

# Python virtualenv (one-off .py scratch scripts are covered below)
.venv/
__pycache__/
*.pyc

# Dev scratch files
diff*.txt
patch*.js
script*.py
update_script.js
fix_*.py

# Temporary files
*.tmp
*.temp

# Screenshots (optional - uncomment if you don't want to commit them)
# screenshots/
